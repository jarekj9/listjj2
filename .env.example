# Copy to .env and adjust. The real .env is not committed.

# Required: secret for login tokens (e.g. output of: openssl rand -hex 32)
JWT_SECRET=change-me
JWT_EXPIRY_DAYS=30

# Initial administrator bootstrap: set an email and a long random setup token.
ADMIN_EMAIL=you@example.com
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-value

# Database: SQLite (default, /data/listjj.db in the container) or PostgreSQL (see docker-compose.yml)
DATABASE_URL=sqlite:////data/listjj.db
# DATABASE_URL=postgresql+psycopg://listjj:change-me@db:5432/listjj
# POSTGRES_PASSWORD=change-me

# Optional social login
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# Frontend port on the host
FRONTEND_PORT=8092

MAX_UPLOAD_MB=20
DEPLOYMENT_NAME=home
